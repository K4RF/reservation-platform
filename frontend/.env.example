# Browser-visible API prefix. Use an absolute URL only when Backend CORS permits it.
VITE_API_BASE_URL=/api/v1
# Vite development-server proxy target (not exposed in the browser bundle).
API_PROXY_TARGET=http://localhost:8080
# Public Backend origin used for browser navigation to Google OAuth2. Never put a secret here.
VITE_OAUTH2_BACKEND_URL=http://localhost:8080
